# Connection string for the demo PostgreSQL instance.
# This value matches the docker-compose.yml service, so `npm run db:up`
# followed by the app / tests works with no further configuration.
#
# NOTE: for this demo the app connects as a privileged role and then drops to
# the non-privileged `app_user` role per transaction (see lib/db.ts). In a real
# deployment you would instead give `app_user` a password + LOGIN and connect
# directly as it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
